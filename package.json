{
  "name": "lode",
  "version": "0.1.2",
  "private": true,
  "description": "Local-first learning backlog that an LLM organises into subtopic notes, with your own points highlighted.",
  "author": {
    "name": "Kumudu Mohottala",
    "email": "kumudulaksitha@gmail.com"
  },
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --linux --publish never",
    "eval": "vitest run --config vitest.eval.config.mts",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "homepage": "https://gitlab.com/mohotta/lode",
  "desktopName": "lode.desktop",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/mohotta/lode.git"
  },
  "bugs": {
    "url": "https://gitlab.com/mohotta/lode/-/issues"
  }
}
